# Copy this file to .env.local.
#
# Recommended (production): generate a bcrypt hash and use ADMIN_PASSWORD_HASH.
#   npm run hash-password -- "your-new-password"
ADMIN_PASSWORD_HASH=

# Fallback for local dev only — plain text, used if ADMIN_PASSWORD_HASH is unset.
ADMIN_PASSWORD=changeme

# Random long string used to sign admin session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-64-char-hex-string
